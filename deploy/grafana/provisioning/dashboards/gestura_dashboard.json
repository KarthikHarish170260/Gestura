{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Active Sessions",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "gestura_active_sessions", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 2,
      "title": "Total HTTP Requests",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(gestura_requests_total)", "refId": "A" }],
      "options": { "colorMode": "value" }
    },
    {
      "id": 3,
      "title": "Trainer Status",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "gestura_training_job_status", "refId": "A" }],
      "options": { "colorMode": "background" }
    },
    {
      "id": 4,
      "title": "Total Errors",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "sum(gestura_errors_total) or vector(0)", "refId": "A" }],
      "options": { "colorMode": "value" }
    },
    {
      "id": 5,
      "title": "Landmark Inference Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(gestura_inference_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Inference",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "STT & TTS Latencies (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(gestura_stt_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 STT",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(gestura_tts_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 TTS",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["gestura", "telemetry"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "GESTURA Runtime Telemetry",
  "version": 1
}
