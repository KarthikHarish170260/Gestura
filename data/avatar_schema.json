{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GesturaAvatarClip",
  "type": "object",
  "required": ["version", "gloss", "fps", "frame_count", "landmarks"],
  "properties": {
    "version": { "type": "string", "enum": ["1.0.0"] },
    "gloss": { "type": "string" },
    "fps": { "type": "number", "minimum": 15, "maximum": 60 },
    "frame_count": { "type": "integer", "minimum": 1 },
    "duration_ms": { "type": "number" },
    "landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frame_index", "pose", "left_hand", "right_hand"],
        "properties": {
          "frame_index": { "type": "integer" },
          "timestamp_ms": { "type": "number" },
          "pose": {
            "type": "array",
            "description": "12 key upper-body landmarks [x, y, z, visibility]",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 4,
              "maxItems": 4
            },
            "minItems": 12,
            "maxItems": 12
          },
          "left_hand": {
            "type": "array",
            "description": "21 left hand landmarks [x, y, z]",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            },
            "minItems": 0,
            "maxItems": 21
          },
          "right_hand": {
            "type": "array",
            "description": "21 right hand landmarks [x, y, z]",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            },
            "minItems": 0,
            "maxItems": 21
          }
        }
      }
    }
  }
}
