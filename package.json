{
  "name": "gestura-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Offline single-device bidirectional sign-language communication app",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "node scripts/start-desktop.js",
    "dev": "npm --workspace=apps/desktop run dev",
    "preview": "npm --workspace=apps/desktop run preview",
    "build": "npm --workspace=apps/desktop run build",
    "dev:web": "npm --workspace=apps/web run dev",
    "build:web": "npm --workspace=apps/web run build",
    "start:web": "npm --workspace=apps/web run start",
    "open:web": "powershell -NoProfile -Command \"Start-Process 'http://localhost:3000'\"",
    "open:demo": "powershell -NoProfile -Command \"Start-Process 'http://localhost:3000/patient'; Start-Process 'http://localhost:3000/nurse'\"",
    "typecheck:web": "npm --workspace=apps/web run typecheck",
    "lint": "npm --workspace=apps/desktop run lint",
    "typecheck": "npm --workspace=apps/desktop run typecheck",
    "test": "npm --workspace=apps/desktop run test",
    "test:e2e": "npm --workspace=apps/desktop run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5"
  }
}
